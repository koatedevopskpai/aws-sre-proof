apiVersion: apiserver.config.k8s.io/v1
kind: AdmissionConfiguration
plugins:
  - name: PodSecurity
    configuration:
      apiVersion: pod-security.admission.config.k8s.io/v1
      kind: PodSecurityConfiguration
      defaults:
        # Baseline everywhere by default; tenant namespaces opt in to
        # restricted with labels. This makes the secure posture explicit and
        # reviewable rather than relying on every manifest author.
        enforce: baseline
        enforce-version: latest
        audit: restricted
        audit-version: latest
        warn: restricted
        warn-version: latest
      exemptions:
        # RKE2 and the platform components (node-exporter, Falco, Fluent Bit)
        # legitimately need host namespaces or hostPath. They are exempt from
        # PSA. Native tenant CEL policies do not cover these exemptions;
        # their privileged access must be reviewed separately.
        namespaces:
          - kube-system
          - kube-public
          - kube-node-lease
          - platform-system
          - security-system
        runtimeClasses: []
        usernames: []
